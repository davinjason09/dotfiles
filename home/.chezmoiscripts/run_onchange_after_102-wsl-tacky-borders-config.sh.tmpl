#!{{ lookPath "bash" }}

set -euo pipefail

{{ $config_root := joinPath .chezmoi.workingTree "home/dot_config/tacky-borders" }}
# tacky-borders hash: {{ output "bash" "-c" (print "fd . " $config_root " -t file --max-depth=1 -E 'README.md' -x sha256sum -b {} \\; | sort | sha256sum | cut -d \" \" -f1") }}

if [ -z "${WIN_HOME:-}" ]; then
  echo "WIN_HOME is not set. Please set it to your Windows home directory."
  exit 1
fi

if [ -d "$WIN_HOME/.config/tacky-borders/" ]; then
  echo "Updating tacky-borders configuration..."
  fd . {{ joinPath .chezmoi.sourceDir "dot_config" "tacky-borders" | quote }} -t file --max-depth=1 -E "README.md" -x cp {} "$WIN_HOME/.config/tacky-borders/"
else
  echo "tacky-borders directory not found."
fi
