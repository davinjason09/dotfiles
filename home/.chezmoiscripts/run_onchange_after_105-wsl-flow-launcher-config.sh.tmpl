#!{{ lookPath "bash" }}

set -euo pipefail

# flowlauncher hash: {{ include "dot_config/flowlauncher/Catppuccin_Mocha.xaml" | sha256sum }}

if [ -z "${WIN_HOME:-}" ]; then
  echo "WIN_HOME is not set. Please set it to your Windows home directory."
  exit 1
fi

if [ -d "$WIN_HOME/AppData/Roaming/FlowLauncher/Themes/" ]; then
  echo "Updating Flow Launcher configuration..."
  cp -r {{ joinPath .chezmoi.sourceDir "dot_config" "flowlauncher" "Catppuccin_Mocha.xaml" | quote }} "$WIN_HOME/AppData/Roaming/FlowLauncher/Themes/"
else
  echo "Flow Launcher directory not found."
fi


