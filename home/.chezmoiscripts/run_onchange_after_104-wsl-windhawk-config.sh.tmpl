#!{{ lookPath "bash" }}

set -euo pipefail

{{ $config_root := joinPath .chezmoi.workingTree "home/dot_config/windhawk" }}
# windhawk hash: {{ output "bash" "-c" (print "fd . " $config_root " -t file -x sha256sum -b {} \\; | sort | sha256sum | cut -d \" \" -f1") }}

if [ -z "${WIN_HOME:-}" ]; then
  echo "WIN_HOME is not set. Please set it to your Windows home directory."
  exit 1
fi

if [ -d "$WIN_HOME/.config/windhawk/" ]; then
  echo "Updating windhawk configuration..."
  cp -r {{ joinPath .chezmoi.sourceDir "dot_config" "windhawk" | quote }} "$WIN_HOME/.config/windhawk"
else
  echo "windhawk directory not found."
fi


