{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "pathStrict": true
  },
  "workspace": {
    "workspaceRoots": ["lua"],
    "library": ["$VIMRUNTIME", "$XDG_DATA_HOME/nvim/lazy/lazy.nvim/lua", "$XDG_DATA_HOME/nvim/lazy"],
    "checkThirdParty": false,
    "ignoreDir": ["/lua"],
    "ignoreGlobs": ["**/*_spec.lua", "**/minit.lua", "**/busted.lua"]
  },
  "diagnostics": {
    "disable": [
      "assign-type-mismatch",
      "global-in-non-module",
      "missing-fields",
      "need-check-nil",
      "param-type-mismatch",
      "unnecessary-if",
      "unnecessary-assert"
    ]
  }
}
