#!/usr/bin/env bash

set -euo pipefail

help() {
  printf "\033[1mUsage: convert_img [OPTIONS] <input_files>\033[0m\n\n"
  printf "\033[1m\033[4mOptions:\033[0m\n"
  printf "  \033[1m--help, -h\033[0m\t\tDisplay this help message and exit\n"
  printf "  \033[1m--format, -f\033[0m <format>\tSpecify the output image format (png, jpg, webp)\n\n"
  printf "\033[1m\033[4mExamples:\033[0m\n"
  printf '  $ convert_img -f png image.jpg\n'
  printf '  $ convert_img *.jpg -f png\n'
  printf '  $ convert_img --format webp image.png\n'
}

if [ $# -eq 0 ]; then
  help
  exit 1
fi

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  help
  exit 0
fi

require=("magick")
format="jpg" # Default format
input_files=()

while [ $# -gt 0 ]; do
  case "$1" in
    -f | --format)
      if [ -z "${2:-}" ]; then
        echo "Error: No format specified after $1"
        exit 1
      fi
      format="$2"
      shift 2
      ;;
    -*)
      echo "Error: Unknown option $1"
      help
      exit 1
      ;;
    *)
      input_files+=("$1")
      shift
      ;;
  esac
done

if [ ${#input_files[@]} -eq 0 ]; then
  echo "Error: No input files specified"
  help
  exit 1
fi

convert() {
  filename="$1"
  base="${filename%.*}"
  output="${base}.${format}"

  if [ ! -f "$filename" ]; then
    echo "Error: File '$filename' does not exist"
    return 1
  fi

  magick "$filename" "$output"
}

for cmd in "${require[@]}"; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "Error: Required command '$cmd' not found. Please install it."
    exit 1
  fi
done

for file in "${input_files[@]}"; do
  echo "Converting '$file' ..."
  convert "$file"
done
