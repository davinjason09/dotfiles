{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "grep": "deny"
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  },
  "mcp": {
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "enabled": true
    },
    "nushell": {
      "type": "local",
      "command": ["nu", "--mcp"],
      "enabled": true
    }
  },
  "plugin": ["@slkiser/opencode-quota", "oh-my-opencode-slim"],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
